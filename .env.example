# Application Environment
APP_ENV=dev
APP_SECRET=CHANGE_ME_IN_PRODUCTION

# Database Connection
DATABASE_URL="mysql://servicedesk:password@127.0.0.1:3306/servicedesk?serverVersion=8.0.32&charset=utf8mb4"

# Docker MySQL Environment Variables
MYSQL_DATABASE=servicedesk
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_USER=servicedesk
MYSQL_PASSWORD=CHANGE_ME_PASSWORD

# JWT Authentication
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=CHANGE_ME_JWT_PASSPHRASE

# AI Provider Configuration (mock | openai | anthropic)
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# Container Registry Image
GHCR_IMAGE=ghcr.io/your-org/service-desk-backend:latest

{% extends 'base.html.twig' %}

{% block title %}Reports & Analytics | Enterprise Service Desk{% endblock %}

{% block body %}
<div class="main-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
    <div class="header-title">
        <h1>Admin Reporting Dashboard</h1>
        <p>Analyze workload distribution, CSAT ratings, resolution times, and export registry data.</p>
    </div>
    <div style="display: flex; gap: 12px;">
        <a href="{{ path('app_report_export_csv', app.request.query.all) }}" class="btn btn-secondary">📥 Export CSV</a>
        <a href="{{ path('app_report_export_pdf', app.request.query.all) }}" class="btn btn-primary">📄 Export PDF</a>
    </div>
</div>

<!-- Report filter parameters -->
<div class="card glass-panel" style="padding: 24px; margin-bottom: 32px;">
    <form action="{{ path('app_report_index') }}" method="get" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)) auto; gap: 16px; align-items: flex-end;">
        <div>
            <label for="date_preset" class="form-label" style="font-size: 12px;">Date Filter Preset</label>
            <select id="date_preset" name="date_preset" class="form-input" onchange="toggleCustomDates(this.value)">
                <option value="today" {% if selected_preset == 'today' %}selected{% endif %}>Today</option>
                <option value="last_7_days" {% if selected_preset == 'last_7_days' %}selected{% endif %}>Last 7 Days</option>
                <option value="last_30_days" {% if selected_preset == 'last_30_days' %}selected{% endif %}>Last 30 Days</option>
                <option value="this_month" {% if selected_preset == 'this_month' %}selected{% endif %}>This Month</option>
                <option value="previous_month" {% if selected_preset == 'previous_month' %}selected{% endif %}>Previous Month</option>
                <option value="custom" {% if selected_preset == 'custom' %}selected{% endif %}>Custom Date Range</option>
            </select>
        </div>

        <div id="customStartGroup" style="display: {% if selected_preset == 'custom' %}block{% else %}none{% endif %};">
            <label for="start_date" class="form-label" style="font-size: 12px;">Start Date</label>
            <input type="date" id="start_date" name="start_date" value="{{ start_date }}" class="form-input">
        </div>
        
        <div id="customEndGroup" style="display: {% if selected_preset == 'custom' %}block{% else %}none{% endif %};">
            <label for="end_date" class="form-label" style="font-size: 12px;">End Date</label>
            <input type="date" id="end_date" name="end_date" value="{{ end_date }}" class="form-input">
        </div>

        <div>
            <label for="technician" class="form-label" style="font-size: 12px;">Technician</label>
            <select id="technician" name="technician" class="form-input">
                <option value="">All Technicians</option>
                {% for tech in technicians %}
                    <option value="{{ tech.id }}" {% if selected_technician == tech.id %}selected{% endif %}>{{ tech.firstName }} {{ tech.lastName }}</option>
                {% endfor %}
            </select>
        </div>

        <div>
            <button type="submit" class="btn btn-secondary" style="width: 100%;">📊 Filter</button>
        </div>
    </form>
</div>

<!-- Key Performance Indicators (KPI Grid) -->
<div class="grid-4" style="margin-bottom: 32px; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px;">
    <div class="card glass-panel metric-card">
        <span class="metric-title">📋 Total Tickets</span>
        <span class="metric-value">{{ totalTickets }}</span>
    </div>
    <div class="card glass-panel metric-card">
        <span class="metric-title" style="color: #10b981;">✅ Closed / Resolved</span>
        <span class="metric-value" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
            {{ closedCount }}
        </span>
    </div>
    <div class="card glass-panel metric-card">
        <span class="metric-title" style="color: #7c3aed;">⏱️ Avg Resolution</span>
        <span class="metric-value" style="background: linear-gradient(135deg, #7c3aed 0%, #a855f7 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
            {{ avgResolutionTime }} hrs
        </span>
    </div>
    <div class="card glass-panel metric-card">
        <span class="metric-title" style="color: #f59e0b;">⭐ CSAT Rating</span>
        <span class="metric-value" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
            {{ csatAverage }}/5.0
        </span>
        <span style="font-size: 11px; color: #64748b; margin-top: 4px;">Based on {{ csatCount }} reviews</span>
    </div>
</div>

<!-- Distribution Metrics Grid -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; margin-bottom: 32px;">
    <!-- CSAT Distribution Breakdown -->
    <div class="card glass-panel" style="padding: 20px;">
        <h3 style="font-size: 15px; font-weight: 700; margin-bottom: 16px; color: #334155;">⭐ CSAT Star Breakdown</h3>
        {% for star in 5..1 %}
            {% set cnt = csatDistribution[star] ?? 0 %}
            {% set pct = csatCount > 0 ? (cnt / csatCount * 100)|round(1) : 0 %}
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px; font-size: 13px;">
                <span style="width: 50px; font-weight: 600;">{{ star }} Stars</span>
                <div style="flex: 1; height: 8px; background: #e2e8f0; border-radius: 4px; overflow: hidden;">
                    <div style="width: {{ pct }}%; height: 100%; background: #f59e0b;"></div>
                </div>
                <span style="width: 60px; text-align: right; color: #64748b;">{{ cnt }} ({{ pct }}%)</span>
            </div>
        {% endfor %}
    </div>

    <!-- Tickets by Status -->
    <div class="card glass-panel" style="padding: 20px;">
        <h3 style="font-size: 15px; font-weight: 700; margin-bottom: 16px; color: #334155;">📊 Tickets by Status</h3>
        {% for st, cnt in byStatus %}
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 6px 0; border-bottom: 1px solid #f1f5f9; font-size: 13px;">
                <span style="font-weight: 600; color: #475569;">{{ st }}</span>
                <span class="badge badge-primary">{{ cnt }}</span>
            </div>
        {% endfor %}
    </div>

    <!-- Tickets by Priority -->
    <div class="card glass-panel" style="padding: 20px;">
        <h3 style="font-size: 15px; font-weight: 700; margin-bottom: 16px; color: #334155;">🔥 Tickets by Priority</h3>
        {% for pr, cnt in byPriority %}
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 6px 0; border-bottom: 1px solid #f1f5f9; font-size: 13px;">
                <span style="font-weight: 600; color: #475569;">{{ pr }}</span>
                <span class="badge badge-secondary">{{ cnt }}</span>
            </div>
        {% endfor %}
    </div>
</div>

<!-- Generated Data Registry Table -->
<div class="card glass-panel">
    <h3 style="font-size: 18px; font-weight: 700; margin-bottom: 20px;">Filtered Ticket Logs ({{ tickets|length }} matches)</h3>
    
    {% if tickets|length == 0 %}
        <p style="color: var(--text-secondary); text-align: center; padding: 40px 0;">No ticket logs found for the selected parameters.</p>
    {% else %}
        <div class="table-container">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th>Number</th>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Created By</th>
                        <th>Assigned To</th>
                        <th>Created At</th>
                    </tr>
                </thead>
                <tbody>
                    {% for ticket in tickets %}
                        <tr>
                            <td>
                                <a href="{{ path('app_ticket_show', {'id': ticket.id}) }}" style="font-weight: 700;">
                                    {{ ticket.ticketNumber }}
                                </a>
                            </td>
                            <td style="max-width: 160px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                {{ ticket.title }}
                            </td>
                            <td>{{ ticket.category }}</td>
                            <td>
                                <span class="badge badge-{{ ticket.priority|lower }}">
                                    {{ ticket.priority }}
                                </span>
                            </td>
                            <td>
                                <span class="badge badge-{{ ticket.status|lower|replace({' ': ''}) }}">
                                    {{ ticket.status }}
                                </span>
                            </td>
                            <td>{{ ticket.createdBy ? ticket.createdBy.firstName ~ ' ' ~ ticket.createdBy.lastName : 'Unknown' }}</td>
                            <td>{{ ticket.assignedTo ? ticket.assignedTo.firstName ~ ' ' ~ ticket.assignedTo.lastName : 'Unassigned' }}</td>
                            <td style="font-size: 13px; color: var(--text-muted);">
                                {{ ticket.createdAt|date('d M Y, H:i') }}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>

<script>
function toggleCustomDates(val) {
    const isCustom = val === 'custom';
    document.getElementById('customStartGroup').style.display = isCustom ? 'block' : 'none';
    document.getElementById('customEndGroup').style.display = isCustom ? 'block' : 'none';
}
</script>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}{{ article.title }} | Knowledge Base{% endblock %}

{% block body %}
<div style="max-width: 900px; margin: 0 auto;">
    <div style="margin-bottom: 16px;">
        <a href="{{ path('app_knowledge_index') }}" style="color: var(--text-muted); font-size: 13px; text-decoration: none; font-weight: 600;">
            ← Back to Knowledge Base
        </a>
    </div>

    <!-- Article Card -->
    <div class="card glass-panel" style="padding: 32px; margin-bottom: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; flex-wrap: wrap; gap: 8px;">
            <span class="badge badge-open" style="font-size: 12px;">{{ article.category.icon }} {{ article.category.name }}</span>
            <div style="font-size: 12px; color: var(--text-muted); display: flex; gap: 16px;">
                <span>👁️ {{ article.viewCount }} views</span>
                <span>👍 {{ article.helpfulPercentage }}% helpful</span>
                <span>Updated {{ article.updatedAt ? article.updatedAt|date('d M Y') : article.publishedAt|date('d M Y') }}</span>
            </div>
        </div>

        <h1 style="font-size: 26px; font-weight: 800; margin-bottom: 20px; color: var(--text-primary); line-height: 1.3;">
            {{ article.title }}
        </h1>

        <div style="font-size: 15px; color: var(--text-primary); line-height: 1.7; border-top: 1px solid var(--border-color); padding-top: 20px; margin-bottom: 32px; white-space: pre-line;">
            {{ article.content }}
        </div>

        <!-- Feedback Widget -->
        <div style="background: var(--bg-primary); padding: 20px; border-radius: 12px; text-align: center; border: 1px solid var(--border-color);" id="feedbackBox">
            <p style="font-weight: 700; font-size: 14px; margin-bottom: 12px;" id="feedbackPrompt">Was this article helpful?</p>
            <div style="display: flex; justify-content: center; gap: 12px;" id="feedbackButtons">
                <button type="button" class="btn btn-secondary" onclick="submitArticleFeedback({{ article.id }}, true)" style="min-width: 100px;">
                    👍 Yes
                </button>
                <button type="button" class="btn btn-secondary" onclick="submitArticleFeedback({{ article.id }}, false)" style="min-width: 100px;">
                    👎 No
                </button>
            </div>
            <p id="feedbackThanks" style="display: none; font-size: 13px; font-weight: 600; color: #059669; margin: 0;">
                Thanks for your feedback!
            </p>
        </div>
    </div>

    <!-- Related Articles -->
    {% if relatedArticles|length > 0 %}
        <div class="card glass-panel" style="padding: 24px; margin-bottom: 24px;">
            <h3 style="font-size: 16px; font-weight: 700; margin-bottom: 16px; border-bottom: 1px solid var(--border-color); padding-bottom: 8px;">
                Related Articles
            </h3>
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px;">
                {% for rel in relatedArticles %}
                    <a href="{{ path('app_knowledge_article_show', {'slug': rel.slug}) }}" style="text-decoration: none; padding: 12px; border-radius: 8px; border: 1px solid var(--border-color); background: var(--bg-secondary); display: flex; flex-direction: column; gap: 4px;">
                        <span style="font-size: 13px; font-weight: 700; color: var(--primary-color);">{{ rel.title }}</span>
                        <span style="font-size: 11px; color: var(--text-muted);">👁️ {{ rel.viewCount }} views</span>
                    </a>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    <!-- Didn't Solve Problem CTA -->
    <div class="card glass-panel" style="padding: 20px; background: #fff7ed; border-color: #ffedd5; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
        <div>
            <span style="font-size: 14px; font-weight: 700; color: #c2410c;">This didn't solve my problem?</span>
            <p style="font-size: 12px; color: #ea580c; margin-top: 2px;">Submit a support ticket and our team will investigate further.</p>
        </div>
        <a href="{{ path('app_ticket_create', {'category': article.category.name, 'title': article.title ~ ' issue'}) }}" class="btn btn-primary" style="background: #ea580c; border: none;">
            🎫 Create Support Ticket
        </a>
    </div>
</div>

<script>
    async function submitArticleFeedback(articleId, helpful) {
        try {
            const res = await fetch(`/knowledge/article/${articleId}/feedback`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                body: JSON.stringify({ helpful: helpful })
            });
            const data = await res.json();
            if (data.success) {
                document.getElementById('feedbackButtons').style.display = 'none';
                document.getElementById('feedbackPrompt').style.display = 'none';
                document.getElementById('feedbackThanks').style.display = 'block';
            }
        } catch (e) {
            console.error('Failed to submit feedback');
        }
    }
</script>
{% endblock %}

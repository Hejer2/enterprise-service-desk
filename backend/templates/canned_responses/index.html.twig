{% extends 'base.html.twig' %}

{% block title %}Canned Response Templates | Enterprise Service Desk{% endblock %}

{% block body %}
<div class="main-header">
    <div class="header-title">
        <h1>Canned Response Templates</h1>
        <p>Predefined reply templates for technicians to quickly answer common inquiries.</p>
    </div>
</div>

<div class="grid-3">
    <!-- Form column -->
    <div class="card glass-panel" style="grid-column: span 1; margin-bottom: 0;">
        <h3 style="font-size: 16px; font-weight: 700; margin-bottom: 16px; border-bottom: 1px solid var(--border-color); padding-bottom: 12px;">
            Create New Template
        </h3>

        <form action="{{ path('app_canned_response_index') }}" method="post">
            <div class="form-group">
                <label for="title" class="form-label" style="font-size: 12px; font-weight: 600;">Template Title</label>
                <input type="text" id="title" name="title" class="form-input" placeholder="e.g. Password Reset Instructions" required>
            </div>

            <div class="form-group">
                <label for="category" class="form-label" style="font-size: 12px; font-weight: 600;">Category (Optional)</label>
                <input type="text" id="category" name="category" class="form-input" placeholder="e.g. IT Support, Hardware">
            </div>

            <div class="form-group">
                <label for="content" class="form-label" style="font-size: 12px; font-weight: 600;">Response Content</label>
                <textarea id="content" name="content" class="form-input" rows="5" placeholder="Type response body text here..." required></textarea>
            </div>

            <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center; min-height: 42px;">
                ➕ Save Template
            </button>
        </form>
    </div>

    <!-- Templates list column -->
    <div class="card glass-panel" style="grid-column: span 2; margin-bottom: 0;">
        <h3 style="font-size: 16px; font-weight: 700; margin-bottom: 16px; border-bottom: 1px solid var(--border-color); padding-bottom: 12px;">
            Available Templates ({{ responses|length }})
        </h3>

        {% if responses|length == 0 %}
            {% include 'components/empty_state.html.twig' with {
                'icon': '📝',
                'title': 'No response templates found',
                'message': 'Create your first canned response template using the form.'
            } %}
        {% else %}
            <div style="display: flex; flex-direction: column; gap: 16px;">
                {% for item in responses %}
                    <div style="padding: 16px; background: var(--bg-surface, #ffffff); border: 1px solid var(--border-color, #e2e8f0); border-radius: 10px;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <strong style="font-size: 15px; color: #0f172a;">{{ item.title }}</strong>
                                {% if item.category %}
                                    <span class="badge" style="background: #eff6ff; color: #2563eb; font-size: 11px;">{{ item.category }}</span>
                                {% endif %}
                            </div>
                            <form action="{{ path('app_canned_response_delete', {'id': item.id}) }}" method="post" onsubmit="return confirm('Delete this template?');">
                                <button type="submit" class="btn btn-secondary" style="color: #ef4444; border-color: #fca5a5; padding: 4px 8px; font-size: 12px; min-height: 32px;">
                                    🗑️ Delete
                                </button>
                            </form>
                        </div>
                        <p style="font-size: 13.5px; color: #475569; margin: 0; line-height: 1.5; white-space: pre-wrap;">{{ item.content }}</p>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}

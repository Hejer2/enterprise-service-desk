{% extends 'base.html.twig' %}

{% block title %}Create Ticket | Employee Service Desk{% endblock %}

{% block body %}
<div class="main-header">
    <div class="header-title">
        <h1>Create Service Desk Ticket</h1>
        <p>Log a support ticket, maintenance report, or leave request.</p>
    </div>
</div>

<div class="card glass-panel" style="max-width: 720px; margin: 0 auto;">
    <form action="{{ path('app_ticket_create') }}" method="post" enctype="multipart/form-data">
        <div class="form-group">
            <label for="title" class="form-label">Ticket Title / Summary</label>
            <input type="text" id="title" name="title" class="form-input" placeholder="Brief summary of the issue..." required>
        </div>

        <div class="grid-2">
            <div class="form-group">
                <label for="category" class="form-label">Category</label>
                <select id="category" name="category" class="form-input" required>
                    <option value="IT Support">IT Support</option>
                    <option value="Machine Maintenance">Machine Maintenance</option>
                    <option value="Leave Request">Leave Request</option>
                    <option value="General Request">General Request</option>
                    <option value="Incident">Incident</option>
                    <option value="Suggestion">Suggestion</option>
                </select>
            </div>

            <div class="form-group">
                <label for="priority" class="form-label">Priority</label>
                <select id="priority" name="priority" class="form-input" required>
                    <option value="Low">Low</option>
                    <option value="Medium" selected>Medium</option>
                    <option value="High">High</option>
                    <option value="Critical">Critical</option>
                </select>
            </div>
        </div>



        <!-- Dynamic Leave Request Section -->
        <div id="leave-request-section" class="glass-panel" style="display: none; padding: 20px; margin-bottom: 24px; border-left: 4px solid var(--primary-color);">
            <h3 style="font-size: 16px; font-weight: 700; margin-bottom: 16px;">📅 Leave Request Details</h3>
            
            <div class="form-group">
                <label for="leave_type" class="form-label">Leave Type</label>
                <select id="leave_type" name="leave_type" class="form-input">
                    {% for lt in leave_types %}
                        <option value="{{ lt.id }}">{{ lt.name }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="grid-2">
                <div class="form-group">
                    <label for="start_date" class="form-label">Start Date</label>
                    <input type="date" id="start_date" name="start_date" class="form-input" value="{{ 'now'|date('Y-m-d') }}">
                </div>
                <div class="form-group">
                    <label for="end_date" class="form-label">End Date</label>
                    <input type="date" id="end_date" name="end_date" class="form-input" value="{{ 'now'|date('Y-m-d') }}">
                </div>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <div class="form-group" style="display: flex; align-items: center; gap: 8px; margin-bottom: 0;">
                    <input type="checkbox" id="half_day" name="half_day" value="1" style="width: 18px; height: 18px;">
                    <label for="half_day" class="form-label" style="margin-bottom: 0; cursor: pointer;">Request as Half-Day</label>
                </div>
                <div style="background: rgba(16, 185, 129, 0.1); color: #10b981; padding: 6px 12px; border-radius: 8px; font-weight: 600; font-size: 13px;">
                    ⏱️ Total Duration: <span id="calculated_duration">1 Day(s)</span>
                </div>
            </div>
        </div>

        <div class="form-group">
            <label for="description" class="form-label">Full Description</label>
            <textarea id="description" name="description" class="form-input" rows="6" placeholder="Provide as much detail as possible..." required></textarea>
        </div>

        <div class="form-group">
            <label for="attachments" class="form-label">Upload Attachments (PDF, DOCX, XLSX, JPG, PNG, ZIP)</label>
            <input type="file" id="attachments" name="attachments[]" class="form-input" multiple>
            <small style="color: var(--text-muted); display: block; margin-top: 4px;">You can select multiple files to upload.</small>
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 16px; margin-top: 32px;">
            <a href="{{ path('app_ticket_index') }}" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">Submit Ticket</button>
        </div>
    </form>
</div>

<script>
    // Handle conditional fields for Leave Requests
    document.addEventListener('DOMContentLoaded', () => {
        const catSelect = document.getElementById('category');
        const leaveSection = document.getElementById('leave-request-section');
        const startDateInput = document.getElementById('start_date');
        const endDateInput = document.getElementById('end_date');
        const halfDayInput = document.getElementById('half_day');
        const durationDisplay = document.getElementById('calculated_duration');
        
        function calculateDuration() {
            if (!startDateInput.value || !endDateInput.value) {
                durationDisplay.innerText = "0 Day(s)";
                return;
            }
            const start = new Date(startDateInput.value);
            const end = new Date(endDateInput.value);
            const diffTime = end.getTime() - start.getTime();
            let days = Math.ceil(diffTime / (1000 * 60 * 60 * 24)) + 1; // +1 to include both start and end days
            
            if (days < 0) days = 0;
            if (halfDayInput.checked && days > 0) {
                days -= 0.5;
            }
            durationDisplay.innerText = days + " Day(s)";
        }

        function toggleLeaveSection() {
            if (catSelect.value === 'Leave Request') {
                leaveSection.style.display = 'block';
                startDateInput.required = true;
                endDateInput.required = true;
                calculateDuration();
            } else {
                leaveSection.style.display = 'none';
                startDateInput.required = false;
                endDateInput.required = false;
            }
        }
        
        catSelect.addEventListener('change', toggleLeaveSection);
        startDateInput.addEventListener('change', calculateDuration);
        endDateInput.addEventListener('change', calculateDuration);
        halfDayInput.addEventListener('change', calculateDuration);
        toggleLeaveSection(); // Run on init
    });
</script>
{% endblock %}

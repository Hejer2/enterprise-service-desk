{% extends 'base.html.twig' %}

{% block title %}Settings & Privacy | Accounts Center{% endblock %}

{% block body %}
<div class="main-header">
    <div class="header-title">
        <h1>Accounts Center</h1>
        <p>Manage your unified profile settings, notification parameters, security, and display preferences.</p>
    </div>
</div>

<!-- Top Navigation Tabs Bar -->
<div class="card glass-panel" style="padding: 8px 12px; margin-bottom: 24px; display: flex; flex-wrap: wrap; gap: 8px; border-radius: 14px;">
    <!-- Profile Tab -->
    <a href="{{ path('app_setting_index', {'tab': 'profile'}) }}" 
       style="text-decoration: none; display: flex; align-items: center; gap: 8px; padding: 10px 18px; border-radius: 10px; font-weight: 600; font-size: 13.5px; transition: all 0.2s;
              {% if active_tab == 'profile' %}background: var(--primary-color); color: #ffffff;{% else %}background: transparent; color: var(--text-secondary);{% endif %}">
        <span>👤</span> Personal Details
    </a>

    <!-- Security Tab -->
    {% if is_granted('ROLE_ADMIN') %}
    <a href="{{ path('app_setting_index', {'tab': 'security'}) }}" 
       style="text-decoration: none; display: flex; align-items: center; gap: 8px; padding: 10px 18px; border-radius: 10px; font-weight: 600; font-size: 13.5px; transition: all 0.2s;
              {% if active_tab == 'security' %}background: var(--primary-color); color: #ffffff;{% else %}background: transparent; color: var(--text-secondary);{% endif %}">
        <span>🔒</span> Password & Security
    </a>
    {% endif %}

    <!-- Preferences Tab -->
    <a href="{{ path('app_setting_index', {'tab': 'preferences'}) }}" 
       style="text-decoration: none; display: flex; align-items: center; gap: 8px; padding: 10px 18px; border-radius: 10px; font-weight: 600; font-size: 13.5px; transition: all 0.2s;
              {% if active_tab == 'preferences' %}background: var(--primary-color); color: #ffffff;{% else %}background: transparent; color: var(--text-secondary);{% endif %}">
        <span>🎨</span> App Preferences
    </a>

    <!-- Notifications Tab -->
    <a href="{{ path('app_setting_index', {'tab': 'notifications'}) }}" 
       style="text-decoration: none; display: flex; align-items: center; gap: 8px; padding: 10px 18px; border-radius: 10px; font-weight: 600; font-size: 13.5px; transition: all 0.2s;
              {% if active_tab == 'notifications' %}background: var(--primary-color); color: #ffffff;{% else %}background: transparent; color: var(--text-secondary);{% endif %}">
        <span>🔔</span> Notifications
    </a>

    <!-- Help & Privacy Tab -->
    <a href="{{ path('app_setting_index', {'tab': 'help'}) }}" 
       style="text-decoration: none; display: flex; align-items: center; gap: 8px; padding: 10px 18px; border-radius: 10px; font-weight: 600; font-size: 13.5px; transition: all 0.2s;
              {% if active_tab == 'help' %}background: var(--primary-color); color: #ffffff;{% else %}background: transparent; color: var(--text-secondary);{% endif %}">
        <span>🛡️</span> Privacy & Help
    </a>

    {% if is_granted('ROLE_ADMIN') %}
        <!-- System Config Tab -->
        <a href="{{ path('app_setting_index', {'tab': 'system'}) }}" 
           style="text-decoration: none; display: flex; align-items: center; gap: 8px; padding: 10px 18px; border-radius: 10px; font-weight: 600; font-size: 13.5px; transition: all 0.2s;
                  {% if active_tab == 'system' %}background: var(--primary-color); color: #ffffff;{% else %}background: transparent; color: var(--text-secondary);{% endif %}">
            <span>⚙️</span> System Parameters
        </a>
    {% endif %}
</div>

<!-- Main Settings Detail Panel -->
<div style="display: flex; flex-direction: column; gap: 24px;">

        {% if active_tab == 'profile' %}
            <!-- Tab: Personal Details -->
            <div class="card glass-panel" style="margin-bottom: 0;">
                <h3 style="font-size: 18px; font-weight: 700; margin-bottom: 24px; border-bottom: 1px solid var(--border-color); padding-bottom: 12px;">
                    👤 Personal Details
                </h3>
                
                <form action="{{ path('app_setting_index') }}?tab=profile" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="action" value="update_profile">
                    
                    <div style="display: flex; align-items: center; gap: 20px; margin-bottom: 24px;">
                        <img src="{{ user.profilePicture ?? '/assets/images/default-avatar.png' }}" 
                             alt="Avatar" style="width: 80px; height: 80px; border-radius: 50%; object-fit: cover; border: 2px solid var(--primary-color);">
                        <div>
                            <label for="profilePicture" class="form-label" style="margin-bottom: 6px;">Upload Profile Photo</label>
                            <input type="file" id="profilePicture" name="profilePicture" class="form-input" style="font-size: 12px; padding: 6px 12px;">
                        </div>
                    </div>

                    <div class="grid-2">
                        <div class="form-group">
                            <label for="firstName" class="form-label">First Name</label>
                            <input type="text" id="firstName" name="firstName" value="{{ user.firstName }}" class="form-input" required>
                        </div>
                        <div class="form-group">
                            <label for="lastName" class="form-label">Last Name</label>
                            <input type="text" id="lastName" name="lastName" value="{{ user.lastName }}" class="form-input" required>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="email" class="form-label">Email Address (Read-only)</label>
                        <input type="email" id="email" value="{{ user.email }}" class="form-input" style="background: rgba(0,0,0,0.05); color: var(--text-muted);" readonly>
                    </div>

                    <div class="form-group" style="margin-bottom: 24px;">
                        <label for="phone" class="form-label">Phone Number</label>
                        <input type="text" id="phone" name="phone" value="{{ user.phone }}" class="form-input" placeholder="+1234567890">
                    </div>

                    <div style="display: flex; justify-content: flex-end;">
                        <button type="submit" class="btn btn-primary">💾 Save Personal Info</button>
                    </div>
                </form>
            </div>

            <!-- Role and Authority Information Card -->
            <div class="card glass-panel" style="margin-bottom: 0; padding: 24px;">
                <h4 style="font-size: 15px; font-weight: 700; margin-bottom: 12px;">🛡️ Profile Authorization Status</h4>
                <p style="font-size: 13px; color: var(--text-secondary); margin-bottom: 16px;">
                    Your account is assigned the system role of <strong>{{ user.roleEntity.displayName }}</strong>. Your active permissions include:
                </p>
                <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                    {% for perm in user.roleEntity.permissions %}
                        <span class="badge" style="background: rgba(59, 130, 246, 0.1); color: #3b82f6; font-size: 11px; padding: 4px 10px; border-radius: 8px;">
                            🔑 {{ perm.name|replace({'ROLE_': ''}) }}
                        </span>
                    {% endfor %}
                </div>
            </div>

        {% elseif active_tab == 'security' %}
            <!-- Tab: Password & Security -->
            <div class="card glass-panel" style="margin-bottom: 0;">
                <h3 style="font-size: 18px; font-weight: 700; margin-bottom: 24px; border-bottom: 1px solid var(--border-color); padding-bottom: 12px;">
                    🔒 Password & Security
                </h3>
                
                <form action="{{ path('app_setting_index') }}?tab=security" method="post">
                    <input type="hidden" name="action" value="change_password">
                    
                    <div class="form-group">
                        <label for="currentPassword" class="form-label">Current Password</label>
                        <input type="password" id="currentPassword" name="currentPassword" class="form-input" placeholder="••••••••" required>
                    </div>

                    <div class="form-group">
                        <label for="newPassword" class="form-label">New Password</label>
                        <input type="password" id="newPassword" name="newPassword" class="form-input" placeholder="••••••••" oninput="checkPasswordStrength(this.value)" required>
                        
                        <!-- Password Strength Indicator -->
                        <div style="margin-top: 8px; font-size: 12px;">
                            <div style="height: 6px; width: 100%; background: rgba(255,255,255,0.1); border-radius: 3px; overflow: hidden; margin-bottom: 6px;">
                                <div id="strength-bar" style="height: 100%; width: 0%; background: #ef4444; transition: all 0.3s ease;"></div>
                            </div>
                            <span id="strength-text" style="color: var(--text-muted); font-weight: 600;">Strength: Not entered</span>
                        </div>
                    </div>

                    <div class="form-group" style="margin-bottom: 24px;">
                        <label for="confirmPassword" class="form-label">Confirm New Password</label>
                        <input type="password" id="confirmPassword" name="confirmPassword" class="form-input" placeholder="••••••••" required>
                    </div>

                    <div style="display: flex; justify-content: flex-end;">
                        <button type="submit" class="btn btn-primary">🔑 Update Password</button>
                    </div>
                </form>
            </div>

            <!-- Two-Factor Authentication card -->
            <div class="card glass-panel" style="margin-bottom: 0; padding: 24px;">
                <h4 style="font-size: 15px; font-weight: 700; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
                    🛡️ Two-Factor Authentication (2FA)
                </h4>
                <p style="font-size: 13px; color: var(--text-secondary); margin-bottom: 16px;">
                    Protect your account with an extra layer of security. Logins will require a verification code from your mobile authenticator app.
                </p>
                <div style="display: flex; align-items: center; justify-content: space-between; padding: 12px; background: rgba(16, 185, 129, 0.08); border: 1px solid rgba(16, 185, 129, 0.2); border-radius: 10px;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <span style="font-size: 24px;">📱</span>
                        <div>
                            <div style="font-weight: 600; font-size: 13px;">Authenticator App Status</div>
                            <div style="font-size: 11px; color: var(--text-muted);">Highly Recommended</div>
                        </div>
                    </div>
                    <label class="switch" style="position: relative; display: inline-block; width: 44px; height: 24px;">
                        <input type="checkbox" id="2fa-toggle" onchange="alert('Two-Factor Authentication configuration updated!')" checked style="opacity: 0; width: 0; height: 0;">
                        <span class="slider" style="position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: #10b981; transition: .4s; border-radius: 34px;"></span>
                    </label>
                </div>
            </div>

            <!-- Simulation of Meta's Login Alerts & Active Devices -->
            <div class="card glass-panel" style="margin-bottom: 0; padding: 24px;">
                <h4 style="font-size: 15px; font-weight: 700; margin-bottom: 16px; display: flex; align-items: center; gap: 8px;">
                    📱 Where You're Logged In
                </h4>
                <p style="font-size: 12px; color: var(--text-secondary); margin-bottom: 16px;">
                    Check the devices currently authorized and active on your account.
                </p>
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,0.05);">
                        <div style="display: flex; gap: 12px; align-items: center;">
                            <span style="font-size: 20px;">💻</span>
                            <div>
                                <div style="font-weight: 600; font-size: 13px;">Windows PC · Chrome</div>
                                <div style="font-size: 11px; color: var(--text-muted);">Paris, France · <span style="color: #10b981; font-weight: 600;">Active now</span></div>
                            </div>
                        </div>
                        <span class="badge" style="background: rgba(16, 185, 129, 0.1); color: #10b981; font-size: 11px;">Current Device</span>
                    </div>

                    <div style="display: flex; justify-content: space-between; align-items: center; padding: 8px 0;">
                        <div style="display: flex; gap: 12px; align-items: center;">
                            <span style="font-size: 20px;">📱</span>
                            <div>
                                <div style="font-weight: 600; font-size: 13px;">Apple iPhone 15 · Safari</div>
                                <div style="font-size: 11px; color: var(--text-muted);">Lyon, France · 3 hours ago</div>
                            </div>
                        </div>
                        <span style="font-size: 11px; color: var(--text-muted); cursor: pointer; text-decoration: underline;">Log out</span>
                    </div>
                </div>
            </div>

        {% elseif active_tab == 'preferences' %}
            <!-- Tab: App Preferences -->
            <div class="card glass-panel" style="margin-bottom: 0;">
                <h3 style="font-size: 18px; font-weight: 700; margin-bottom: 24px; border-bottom: 1px solid var(--border-color); padding-bottom: 12px;">
                    🎨 App Preferences
                </h3>
                
                <form action="{{ path('app_setting_index') }}?tab=preferences" method="post">
                    <input type="hidden" name="action" value="update_user_settings">
                    
                    <div class="form-group">
                        <label for="theme" class="form-label">Theme Mode</label>
                        <select id="theme" name="theme" class="form-input">
                            <option value="light" {% if user.theme == 'light' %}selected{% endif %}>☀️ Light Mode</option>
                            <option value="dark" {% if user.theme == 'dark' %}selected{% endif %}>🌙 Dark Mode</option>
                        </select>
                    </div>

                    <div class="form-group" style="margin-bottom: 24px;">
                        <label for="language" class="form-label">Display Language</label>
                        <select id="language" name="language" class="form-input">
                            <option value="en" {% if user.language == 'en' %}selected{% endif %}>English (EN)</option>
                            <option value="ar" {% if user.language == 'ar' %}selected{% endif %}>العربية (AR)</option>
                        </select>
                    </div>

                    <div style="display: flex; justify-content: flex-end;">
                        <button type="submit" class="btn btn-primary">💾 Save Preferences</button>
                    </div>
                </form>
            </div>

        {% elseif active_tab == 'notifications' %}
            <!-- Tab: Notifications Preferences -->
            <div class="card glass-panel" style="margin-bottom: 0;">
                <h3 style="font-size: 18px; font-weight: 700; margin-bottom: 24px; border-bottom: 1px solid var(--border-color); padding-bottom: 12px;">
                    🔔 Notification Preferences
                </h3>
                
                <form action="{{ path('app_setting_index') }}?tab=notifications" method="post">
                    <input type="hidden" name="action" value="update_notification_preferences">
                    
                    <p style="font-size: 13px; color: var(--text-secondary); margin-bottom: 20px;">
                        Configure which events trigger email, in-app notifications, and browser alerts for your account.
                    </p>

                    <div style="display: flex; flex-direction: column; gap: 16px; margin-bottom: 28px;">
                        <label style="display: flex; align-items: flex-start; gap: 14px; cursor: pointer; padding: 12px; background: var(--bg-primary); border: 1px solid var(--border-color); border-radius: 10px;">
                            <input type="checkbox" name="ticketAssignments" value="1" {% if notification_preference.ticketAssignments %}checked{% endif %} style="width: 20px; height: 20px; margin-top: 2px; accent-color: var(--primary-color);">
                            <div>
                                <strong style="font-size: 14px; color: var(--text-primary);">Ticket Assignments & Transfers</strong>
                                <div style="font-size: 12px; color: var(--text-muted); margin-top: 2px;">Receive alerts when a ticket is assigned to you or transferred.</div>
                            </div>
                        </label>

                        <label style="display: flex; align-items: flex-start; gap: 14px; cursor: pointer; padding: 12px; background: var(--bg-primary); border: 1px solid var(--border-color); border-radius: 10px;">
                            <input type="checkbox" name="ticketReplies" value="1" {% if notification_preference.ticketReplies %}checked{% endif %} style="width: 20px; height: 20px; margin-top: 2px; accent-color: var(--primary-color);">
                            <div>
                                <strong style="font-size: 14px; color: var(--text-primary);">Ticket Replies & Comments</strong>
                                <div style="font-size: 12px; color: var(--text-muted); margin-top: 2px;">Receive alerts when employees or technicians reply to your tickets.</div>
                            </div>
                        </label>

                        <label style="display: flex; align-items: flex-start; gap: 14px; cursor: pointer; padding: 12px; background: var(--bg-primary); border: 1px solid var(--border-color); border-radius: 10px;">
                            <input type="checkbox" name="ticketStatusChanges" value="1" {% if notification_preference.ticketStatusChanges %}checked{% endif %} style="width: 20px; height: 20px; margin-top: 2px; accent-color: var(--primary-color);">
                            <div>
                                <strong style="font-size: 14px; color: var(--text-primary);">Ticket Status Updates</strong>
                                <div style="font-size: 12px; color: var(--text-muted); margin-top: 2px;">Notify me when a ticket status transitions (Open, In Progress, Resolved, Closed).</div>
                            </div>
                        </label>

                        <label style="display: flex; align-items: flex-start; gap: 14px; cursor: pointer; padding: 12px; background: var(--bg-primary); border: 1px solid var(--border-color); border-radius: 10px;">
                            <input type="checkbox" name="slaAlerts" value="1" {% if notification_preference.slaAlerts %}checked{% endif %} style="width: 20px; height: 20px; margin-top: 2px; accent-color: var(--primary-color);">
                            <div>
                                <strong style="font-size: 14px; color: var(--text-primary);">SLA Escalation & Breach Warnings</strong>
                                <div style="font-size: 12px; color: var(--text-muted); margin-top: 2px;">Priority alerts when response or resolution SLA timers are approaching breach.</div>
                            </div>
                        </label>

                        <label style="display: flex; align-items: flex-start; gap: 14px; cursor: pointer; padding: 12px; background: var(--bg-primary); border: 1px solid var(--border-color); border-radius: 10px;">
                            <input type="checkbox" name="systemNotifications" value="1" {% if notification_preference.systemNotifications %}checked{% endif %} style="width: 20px; height: 20px; margin-top: 2px; accent-color: var(--primary-color);">
                            <div>
                                <strong style="font-size: 14px; color: var(--text-primary);">System Announcements & Broadcasts</strong>
                                <div style="font-size: 12px; color: var(--text-muted); margin-top: 2px;">Important scheduled maintenance and IT service announcements.</div>
                            </div>
                        </label>

                        <label style="display: flex; align-items: flex-start; gap: 14px; cursor: pointer; padding: 12px; background: var(--bg-primary); border: 1px solid var(--border-color); border-radius: 10px;">
                            <input type="checkbox" name="browserNotifications" value="1" {% if notification_preference.browserNotifications %}checked{% endif %} style="width: 20px; height: 20px; margin-top: 2px; accent-color: var(--primary-color);">
                            <div>
                                <strong style="font-size: 14px; color: var(--text-primary);">Browser Push & Sound Alerts</strong>
                                <div style="font-size: 12px; color: var(--text-muted); margin-top: 2px;">Live in-browser toast and notification badge updates in real time.</div>
                            </div>
                        </label>
                    </div>

                    <div style="display: flex; justify-content: flex-end;">
                        <button type="submit" class="btn btn-primary">💾 Save Notification Preferences</button>
                    </div>
                </form>
            </div>

        {% elseif active_tab == 'help' %}
            <!-- Tab: Privacy & Help -->
            <div class="card glass-panel" style="margin-bottom: 0;">
                <h3 style="font-size: 18px; font-weight: 700; margin-bottom: 24px; border-bottom: 1px solid var(--border-color); padding-bottom: 12px;">
                    🛡️ Privacy & Help Center
                </h3>
                
                <div style="display: flex; flex-direction: column; gap: 20px;">
                    <div>
                        <h4 style="font-weight: 700; font-size: 14px; margin-bottom: 6px;">How are ticket priorities routed?</h4>
                        <p style="font-size: 13px; color: var(--text-secondary); line-height: 1.5;">
                            Tickets are auto-routed based on the category chosen. Leave requests route to HR managers, IT problems route to IT technicians, and general issues route to maintenance.
                        </p>
                    </div>

                    <div>
                        <h4 style="font-weight: 700; font-size: 14px; margin-bottom: 6px;">What are the SLA guidelines?</h4>
                        <p style="font-size: 13px; color: var(--text-secondary); line-height: 1.5;">
                            Under normal operations, Critical tickets target resolution within 2 hours, High tickets within 8 hours, and Medium tickets within 24 hours.
                        </p>
                    </div>

                    <div>
                        <h4 style="font-weight: 700; font-size: 14px; margin-bottom: 6px;">Enterprise Policy & Data</h4>
                        <p style="font-size: 13px; color: var(--text-secondary); line-height: 1.5;">
                            We protect your personal data. All communication records are logged to ensure compliance and support transparency.
                        </p>
                    </div>

                    <button class="btn btn-secondary" onclick="alert('Downloading Enterprise Support Manual...');" style="align-self: flex-start; margin-top: 12px;">
                        📘 Download Support Guide (PDF)
                    </button>
                </div>
            </div>

        {% elseif active_tab == 'system' and is_granted('ROLE_ADMIN') %}
            <!-- Tab: System Parameters -->
            <div class="card glass-panel" style="margin-bottom: 0;">
                <h3 style="font-size: 18px; font-weight: 700; margin-bottom: 24px; border-bottom: 1px solid var(--border-color); padding-bottom: 12px;">
                    ⚙️ System Configuration
                </h3>
                
                <form action="{{ path('app_setting_index') }}?tab=system" method="post">
                    <input type="hidden" name="action" value="update_system_settings">
                    
                    {% for setting in settings %}
                        <div class="form-group">
                            <label for="{{ setting.settingKey }}" class="form-label">
                                {{ setting.settingKey|replace({'_': ' '})|title }}
                            </label>
                            <input type="text" id="{{ setting.settingKey }}" name="{{ setting.settingKey }}" value="{{ setting.settingValue }}" class="form-input" required>
                        </div>
                    {% endfor %}

                    <div style="display: flex; justify-content: flex-end; margin-top: 32px;">
                        <button type="submit" class="btn btn-primary">
                            💾 Save System Parameters
                        </button>
                    </div>
                </form>
            </div>
        {% endif %}
    </div>

<style>
    .settings-nav-item:hover {
        background: rgba(255, 255, 255, 0.04) !important;
        transform: translateX(4px);
    }
    
    /* Toggle Switch Styles */
    .slider:before {
        position: absolute;
        content: "";
        height: 16px;
        width: 16px;
        left: 4px;
        bottom: 4px;
        background-color: white;
        transition: .4s;
        border-radius: 50%;
    }
    input:checked + .slider:before {
        transform: translateX(20px);
    }
</style>

<script>
    function checkPasswordStrength(password) {
        const strengthBar = document.getElementById('strength-bar');
        const strengthText = document.getElementById('strength-text');
        if (!password) {
            strengthBar.style.width = '0%';
            strengthText.innerText = 'Strength: Not entered';
            strengthText.style.color = 'var(--text-muted)';
            return;
        }
        let score = 0;
        if (password.length >= 8) score++;
        if (/[A-Z]/.test(password)) score++;
        if (/[a-z]/.test(password)) score++;
        if (/[0-9]/.test(password)) score++;
        if (/[^A-Za-z0-9]/.test(password)) score++;

        let percent = (score / 5) * 100;
        strengthBar.style.width = percent + '%';

        if (score <= 2) {
            strengthBar.style.backgroundColor = '#ef4444';
            strengthText.innerText = 'Strength: Weak (Needs uppercase, numbers, and symbols)';
            strengthText.style.color = '#ef4444';
        } else if (score <= 4) {
            strengthBar.style.backgroundColor = '#f59e0b';
            strengthText.innerText = 'Strength: Medium (Add special characters/numbers)';
            strengthText.style.color = '#f59e0b';
        } else {
            strengthBar.style.backgroundColor = '#10b981';
            strengthText.innerText = 'Strength: Strong (Secure password)';
            strengthText.style.color = '#10b981';
        }
    }
</script>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Automation Rules & Workflow Engine | Admin Portal{% endblock %}

{% block body %}
<div class="main-header">
    <div class="header-title">
        <h1>Automation & Workflow Engine</h1>
        <p>Manage rule-based routing, automatic assignment, and review execution logs.</p>
    </div>
</div>

<div class="card glass-panel" style="padding: 24px; margin-bottom: 24px;">
    <h3 style="font-size: 16px; font-weight: 700; margin-bottom: 16px; border-bottom: 1px solid var(--border-color); padding-bottom: 8px;">
        Active Automation Rules
    </h3>

    <div class="table-container">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>Rule Name</th>
                    <th>Trigger</th>
                    <th>Priority</th>
                    <th>Conditions</th>
                    <th>Actions</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for rule in rules %}
                    <tr>
                        <td style="font-weight: 700;">{{ rule.name }}</td>
                        <td><span class="badge badge-open" style="font-size: 10px;">{{ rule.triggerType }}</span></td>
                        <td>{{ rule.priority }}</td>
                        <td style="font-size: 12px; max-width: 200px; font-family: monospace;">{{ rule.conditions|json_encode }}</td>
                        <td style="font-size: 12px; max-width: 220px; font-family: monospace;">{{ rule.actions|json_encode }}</td>
                        <td>
                            {% if rule.isActive %}
                                <span class="badge badge-open">ACTIVE</span>
                            {% else %}
                                <span class="badge badge-closed">INACTIVE</span>
                            {% endif %}
                        </td>
                        <td>
                            <form action="{{ path('app_admin_automation_rule_toggle', {'id': rule.id}) }}" method="post">
                                <button type="submit" class="btn btn-secondary" style="padding: 4px 8px; font-size: 11px;">
                                    {{ rule.isActive ? 'Disable' : 'Enable' }}
                                </button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="7" style="text-align: center; color: var(--text-muted);">No automation rules configured.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<div class="card glass-panel" style="padding: 24px;">
    <h3 style="font-size: 16px; font-weight: 700; margin-bottom: 16px; border-bottom: 1px solid var(--border-color); padding-bottom: 8px;">
        Recent Workflow Execution History
    </h3>

    <div class="table-container">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>Execution Key</th>
                    <th>Rule</th>
                    <th>Ticket</th>
                    <th>Status</th>
                    <th>Executed At</th>
                </tr>
            </thead>
            <tbody>
                {% for exec in executions %}
                    <tr>
                        <td style="font-size: 11px; font-family: monospace; color: var(--text-muted);">{{ exec.executionKey|slice(0, 24) }}...</td>
                        <td style="font-weight: 600;">{{ exec.rule.name }}</td>
                        <td>
                            {% if exec.ticket %}
                                <a href="{{ path('app_ticket_show', {'id': exec.ticket.id}) }}" style="color: var(--primary-color);">#{{ exec.ticket.ticketNumber }}</a>
                            {% else %}
                                N/A
                            {% endif %}
                        </td>
                        <td><span class="badge badge-open" style="font-size: 10px;">{{ exec.status }}</span></td>
                        <td style="font-size: 12px; color: var(--text-muted);">{{ exec.executedAt|date('d M Y, H:i:s') }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="5" style="text-align: center; color: var(--text-muted);">No execution history recorded yet.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}

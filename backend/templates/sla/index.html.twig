{% extends 'base.html.twig' %}

{% block title %}SLA Management | Admin Portal{% endblock %}

{% block body %}
<div class="main-header">
    <div class="header-title">
        <h1>Service Level Agreement (SLA) Policies</h1>
        <p>Configure response time, resolution deadlines, and warning thresholds per priority.</p>
    </div>
    <div class="header-actions">
        <button type="button" class="btn btn-primary" onclick="openCreateSlaModal()">➕ Add SLA Policy</button>
    </div>
</div>

<div class="card glass-panel">
    <div class="table-container">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>Policy Name</th>
                    <th>Priority</th>
                    <th>First Response</th>
                    <th>Resolution Time</th>
                    <th>Warning Threshold</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for policy in policies %}
                    <tr>
                        <td style="font-weight: 700;">{{ policy.name }}</td>
                        <td>
                            <span class="badge badge-{{ policy.priority|lower }}">
                                {{ policy.priority }}
                            </span>
                        </td>
                        <td>{{ policy.firstResponseMinutes }} minutes</td>
                        <td>{{ (policy.resolutionMinutes / 60)|number_format(1) }} hours ({{ policy.resolutionMinutes }} mins)</td>
                        <td>{{ policy.warningPercentage }}%</td>
                        <td>
                            {% if policy.isActive %}
                                <span class="badge badge-open">Active</span>
                            {% else %}
                                <span class="badge badge-closed">Disabled</span>
                            {% endif %}
                        </td>
                        <td>
                            <div style="display: flex; gap: 8px;">
                                <button type="button" class="btn btn-secondary" style="padding: 4px 8px; font-size: 12px;" 
                                        onclick="openEditSlaModal({{ policy.id }}, '{{ policy.name|e('js') }}', '{{ policy.priority }}', {{ policy.firstResponseMinutes }}, {{ policy.resolutionMinutes }}, {{ policy.warningPercentage }})">
                                    ✏️ Edit
                                </button>
                                <form action="{{ path('app_admin_sla_toggle', {'id': policy.id}) }}" method="post" style="display: inline;">
                                    <button type="submit" class="btn btn-secondary" style="padding: 4px 8px; font-size: 12px; background: {% if policy.isActive %}#fee2e2; color: #b91c1c;{% else %}#dcfce7; color: #15803d;{% endif %} border: none;">
                                        {% if policy.isActive %}⏸ Disable{% else %}▶ Enable{% endif %}
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" style="text-align: center; color: #64748b; padding: 24px;">No SLA policies configured. Click "Add SLA Policy" to get started.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<!-- Create SLA Policy Modal -->
<div id="createSlaModal" class="modal-overlay" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 200; align-items: center; justify-content: center;">
    <div class="card glass-panel" style="width: 100%; max-width: 480px; padding: 24px;">
        <h2 style="margin-bottom: 16px; font-size: 18px;">Create SLA Policy</h2>
        <form action="{{ path('app_admin_sla_create') }}" method="post">
            <div style="margin-bottom: 12px;">
                <label class="form-label" style="font-size: 12px;">Policy Name</label>
                <input type="text" name="name" class="form-input" required placeholder="e.g. Critical Priority SLA">
            </div>
            <div style="margin-bottom: 12px;">
                <label class="form-label" style="font-size: 12px;">Priority</label>
                <select name="priority" class="form-input" required>
                    <option value="Critical">Critical</option>
                    <option value="High">High</option>
                    <option value="Medium">Medium</option>
                    <option value="Low">Low</option>
                </select>
            </div>
            <div style="margin-bottom: 12px;">
                <label class="form-label" style="font-size: 12px;">First Response (Minutes)</label>
                <input type="number" name="firstResponseMinutes" class="form-input" required min="1" value="30">
            </div>
            <div style="margin-bottom: 12px;">
                <label class="form-label" style="font-size: 12px;">Resolution Time (Minutes)</label>
                <input type="number" name="resolutionMinutes" class="form-input" required min="1" value="480">
            </div>
            <div style="margin-bottom: 20px;">
                <label class="form-label" style="font-size: 12px;">Warning Threshold (%)</label>
                <input type="number" name="warningPercentage" class="form-input" required min="1" max="99" value="80">
            </div>
            <div style="display: flex; justify-content: flex-end; gap: 8px;">
                <button type="button" class="btn btn-secondary" onclick="closeCreateSlaModal()">Cancel</button>
                <button type="submit" class="btn btn-primary">Save Policy</button>
            </div>
        </form>
    </div>
</div>

<!-- Edit SLA Policy Modal -->
<div id="editSlaModal" class="modal-overlay" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 200; align-items: center; justify-content: center;">
    <div class="card glass-panel" style="width: 100%; max-width: 480px; padding: 24px;">
        <h2 style="margin-bottom: 16px; font-size: 18px;">Edit SLA Policy</h2>
        <form id="editSlaForm" method="post">
            <div style="margin-bottom: 12px;">
                <label class="form-label" style="font-size: 12px;">Policy Name</label>
                <input type="text" id="editSlaName" name="name" class="form-input" required>
            </div>
            <div style="margin-bottom: 12px;">
                <label class="form-label" style="font-size: 12px;">First Response (Minutes)</label>
                <input type="number" id="editSlaFirstResponse" name="firstResponseMinutes" class="form-input" required min="1">
            </div>
            <div style="margin-bottom: 12px;">
                <label class="form-label" style="font-size: 12px;">Resolution Time (Minutes)</label>
                <input type="number" id="editSlaResolution" name="resolutionMinutes" class="form-input" required min="1">
            </div>
            <div style="margin-bottom: 20px;">
                <label class="form-label" style="font-size: 12px;">Warning Threshold (%)</label>
                <input type="number" id="editSlaWarning" name="warningPercentage" class="form-input" required min="1" max="99">
            </div>
            <div style="display: flex; justify-content: flex-end; gap: 8px;">
                <button type="button" class="btn btn-secondary" onclick="closeEditSlaModal()">Cancel</button>
                <button type="submit" class="btn btn-primary">Update Policy</button>
            </div>
        </form>
    </div>
</div>

<script>
    function openCreateSlaModal() {
        document.getElementById('createSlaModal').style.display = 'flex';
    }
    function closeCreateSlaModal() {
        document.getElementById('createSlaModal').style.display = 'none';
    }
    function openEditSlaModal(id, name, priority, firstResponse, resolution, warning) {
        document.getElementById('editSlaForm').action = '/admin/sla/' + id + '/edit';
        document.getElementById('editSlaName').value = name;
        document.getElementById('editSlaFirstResponse').value = firstResponse;
        document.getElementById('editSlaResolution').value = resolution;
        document.getElementById('editSlaWarning').value = warning;
        document.getElementById('editSlaModal').style.display = 'flex';
    }
    function closeEditSlaModal() {
        document.getElementById('editSlaModal').style.display = 'none';
    }
</script>
{% endblock %}

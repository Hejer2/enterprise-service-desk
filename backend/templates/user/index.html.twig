{% extends 'base.html.twig' %}

{% block title %}Manage Users | Admin Control{% endblock %}

{% block body %}
<div class="main-header">
    <div class="header-title">
        <h1>Manage System Users</h1>
        <p>List, view, and assign roles or departments to registered enterprise employees.</p>
    </div>
    <div class="header-actions">
        <a href="{{ path('app_user_create') }}" class="btn btn-primary">➕ Add New User</a>
    </div>
</div>

<div class="card glass-panel">
    <div class="table-container">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>Full Name</th>
                    <th>Email Address</th>
                    <th>Role</th>

                    <th>Language</th>
                    <th>Theme</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for u in users %}
                    <tr>
                        <td style="font-weight: 600;">{{ u.fullName }}</td>
                        <td>{{ u.email }}</td>
                        <td>
                            <span class="badge" style="background: rgba(79, 70, 229, 0.1); color: var(--primary-color);">
                                {{ u.roleEntity.displayName }}
                            </span>
                        </td>

                        <td>{{ u.language|upper }}</td>
                        <td>{{ u.theme|capitalize }}</td>
                        <td>
                            <div style="display: flex; gap: 8px;">
                                <a href="{{ path('app_user_edit', {'id': u.id}) }}" class="btn btn-secondary" style="font-size: 12px; padding: 6px 12px;">
                                    ✏️ Edit
                                </a>
                                {% if app.user != u %}
                                <form action="{{ path('app_user_delete', {'id': u.id}) }}" method="post" onsubmit="return confirm('Are you sure you want to completely delete this user? This action cannot be undone.');">
                                    <button type="submit" class="btn btn-primary" style="background: #ef4444; border: none; font-size: 12px; padding: 6px 12px;">
                                        🗑️ Delete
                                    </button>
                                </form>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}

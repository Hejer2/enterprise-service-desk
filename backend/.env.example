# Symfony Backend Environment Configuration
APP_ENV=dev
APP_SECRET=CHANGE_ME_IN_PRODUCTION
APP_SHARE_DIR=var/share

DEFAULT_URI=http://localhost

# Database Connection
DATABASE_URL="mysql://servicedesk:password@127.0.0.1:3306/servicedesk?serverVersion=8.0.32&charset=utf8mb4"

# JWT Authentication
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=CHANGE_ME_JWT_PASSPHRASE

# CORS Configuration
CORS_ALLOW_ORIGIN='*'

# Messenger Transport
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# Mailer Configuration
MAILER_DSN=smtp://127.0.0.1:1025

# AI Provider Configuration (mock | openai | anthropic)
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
